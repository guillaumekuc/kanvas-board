#!/bin/sh
# Before a merge commit on main: build, tests and style check pass, and the
# committed bundles (main.js, canvas.js) match src/.
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
npm run --silent check || exit 1
if ! git diff --quiet -- main.js canvas.js; then
  echo "main.js / canvas.js differ from src/: run npm run build and commit." >&2
  exit 1
fi
